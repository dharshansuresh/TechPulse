# ============================================================
# Automotive Engineering AI Assistant - Configuration
# ============================================================

# Environment: development / production
ENVIRONMENT=development
DEBUG=false

# Server Ports
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000
STREAMLIT_PORT=8501

# Storage Paths
DATABASE_URL=sqlite:///storage/app.db
MAX_UPLOAD_SIZE_MB=50

# Embedding & Vector Database
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_COLLECTION_NAME=autosar_hld_knowledge
CHUNK_SIZE=600
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4

# LLM Provider Configuration
# Options: 'auto', 'openai', 'gemini', 'ollama', 'none'
# If no API key is provided, the platform automatically runs in Retrieval-Only Mode.
LLM_PROVIDER=auto

# External Cloud APIs (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local LLM Inference (Optional - e.g. Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
